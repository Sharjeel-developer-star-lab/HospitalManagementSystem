@model IEnumerable<HospitalManagementSystem.Models.Patient>
@{
    ViewData["Title"] = "Patients";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">👤 Patients</h2>
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <a asp-action="Create" class="btn btn-success">+ Add Patient</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No patients registered yet.</div>
    }
    else
    {
        <table class="table table-hover shadow-sm">
            <thead class="table-primary">
                <tr>
                    <th>Name</th>
                    <th>Gender</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Blood Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>@patient.FirstName @patient.LastName</td>
                        <td>@patient.Gender</td>
                        <td>@patient.PhoneNumber</td>
                        <td>@patient.Email</td>
                        <td>@patient.BloodType</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@patient.Id"
                               class="btn btn-info btn-sm">Details</a>
                            <a asp-action="Edit" asp-route-id="@patient.Id"
                               class="btn btn-warning btn-sm">Edit</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@patient.Id"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Delete this patient?')">Delete</a>
                            }
                            >
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>