@model HospitalManagementSystem.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - HospitalMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                background: #1B3A5C;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
                padding: 20px;
            }

            .login-card {
                background: white;
                border-radius: 4px;
                width: 100%;
                max-width: 620px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.3);
                overflow: hidden;
            }

            .card-top {
                padding: 40px 50px 30px;
                text-align: center;
                border-bottom: 1px solid #eee;
            }

            .logo-icon {
                font-size: 5rem;
                display: block;
                margin-bottom: 10px;
            }

            .card-top h1 {
                font-size: 2.2rem;
                font-weight: 700;
                color: #1B3A5C;
                margin-bottom: 5px;
            }

            .card-top p {
                color: #999;
                font-size: 0.9rem;
            }

            .card-body-form {
                padding: 35px 50px 40px;
            }

            .form-label {
                font-weight: 600;
                color: #333;
                font-size: 0.9rem;
                margin-bottom: 6px;
                display: block;
            }

            .form-control {
                width: 100%;
                border-radius: 4px;
                padding: 13px 15px;
                border: 1px solid #ccc;
                font-size: 0.95rem;
                transition: all 0.2s;
                background: #f5f7fa;
                margin-bottom: 20px;
            }

                .form-control:focus {
                    border-color: #1B3A5C;
                    background: white;
                    box-shadow: 0 0 0 3px rgba(27,58,92,0.08);
                    outline: none;
                }

            .remember-row {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 25px;
            }

                .remember-row input {
                    width: 16px;
                    height: 16px;
                    accent-color: #1B3A5C;
                }

                .remember-row label {
                    font-size: 0.88rem;
                    color: #555;
                }

            .btn-login {
                width: 100%;
                background: #1B3A5C;
                color: white;
                border: none;
                border-radius: 4px;
                padding: 15px;
                font-size: 1.05rem;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s;
                letter-spacing: 0.5px;
            }

                .btn-login:hover {
                    background: #2B6CB0;
                }

            .register-link {
                text-align: center;
                margin-top: 20px;
                font-size: 0.88rem;
                color: #888;
            }

                .register-link a {
                    color: #1B3A5C;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .register-link a:hover {
                        text-decoration: underline;
                    }

            .card-footer-info {
                text-align: center;
                padding: 15px;
                font-size: 0.78rem;
                color: rgba(255,255,255,0.6);
                margin-top: 15px;
            }

            .alert-danger {
                background: #fff5f5;
                border-left: 4px solid #e53e3e;
                border-radius: 4px;
                padding: 12px 15px;
                font-size: 0.85rem;
                color: #c53030;
                margin-bottom: 20px;
            }

            .alert-success {
                background: #f0fff4;
                border-left: 4px solid #38a169;
                border-radius: 4px;
                padding: 12px 15px;
                font-size: 0.85rem;
                color: #276749;
                margin-bottom: 20px;
            }

            .text-danger {
                font-size: 0.78rem;
                color: #e53e3e;
                display: block;
                margin-top: -15px;
                margin-bottom: 15px;
            }
    </style>
</head>
<body>

    <div class="login-card">

        <!-- Top Logo Section -->
        <div class="card-top">
            <span class="logo-icon">🏥</span>
            <h1>HospitalMS</h1>
            <p>Sign in to your account</p>
        </div>

        <!-- Form Section -->
        <div class="card-body-form">

            @if (TempData["Success"] != null)
            {
                <div class="alert-success">✅ @TempData["Success"]</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-danger">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Login" method="post">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control"
                       placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control"
                       placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <div class="remember-row" style="justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <input asp-for="RememberMe" type="checkbox" />
                        <label asp-for="RememberMe">Remember me</label>
                    </div>
                    <a asp-controller="Account" asp-action="ForgotPassword"
                       style="color: #1B3A5C; font-size: 0.85rem;
                        font-weight: 600; text-decoration: none;">
                        Forgot Password?
                    </a>
                </div>

                <button type="submit" class="btn-login">Login</button>
            </form>

            <div class="register-link">
                Don't have an account?
                <a asp-action="Register">Create one here</a>
            </div>
        </div>
    </div>

    <!-- Footer Info -->
    <div class="card-footer-info">
        HospitalMS — Dublin, Ireland &nbsp;|&nbsp;
        Tel: +353 831726604 &nbsp;|&nbsp;
        © 2026 HospitalMS. All Rights Reserved.
    </div>

</body>
</html>