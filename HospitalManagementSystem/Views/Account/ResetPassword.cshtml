@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - HospitalMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                background: #1B3A5C;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
                padding: 20px;
            }

            .card {
                background: white;
                border-radius: 4px;
                width: 100%;
                max-width: 520px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.3);
                overflow: hidden;
            }

            .card-top {
                padding: 35px 45px 25px;
                text-align: center;
                border-bottom: 1px solid #eee;
            }

                .card-top h1 {
                    font-size: 1.8rem;
                    font-weight: 700;
                    color: #1B3A5C;
                }

                .card-top p {
                    color: #999;
                    font-size: 0.88rem;
                }

            .card-body-form {
                padding: 30px 45px 35px;
            }

            .form-label {
                font-weight: 600;
                color: #333;
                font-size: 0.88rem;
                margin-bottom: 6px;
                display: block;
            }

            .form-control {
                width: 100%;
                border-radius: 4px;
                padding: 13px 15px;
                border: 1px solid #ccc;
                font-size: 0.95rem;
                background: #f5f7fa;
                margin-bottom: 20px;
            }

                .form-control:focus {
                    border-color: #1B3A5C;
                    background: white;
                    outline: none;
                }

            .btn-submit {
                width: 100%;
                background: #1B3A5C;
                color: white;
                border: none;
                border-radius: 4px;
                padding: 14px;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
            }

                .btn-submit:hover {
                    background: #2B6CB0;
                }

            .hint {
                font-size: 0.78rem;
                color: #aaa;
                margin-top: -15px;
                margin-bottom: 15px;
            }

            .alert-danger {
                background: #fff5f5;
                border-left: 4px solid #e53e3e;
                border-radius: 4px;
                padding: 12px 15px;
                font-size: 0.85rem;
                color: #c53030;
                margin-bottom: 20px;
            }

            .footer-info {
                text-align: center;
                margin-top: 15px;
                font-size: 0.78rem;
                color: rgba(255,255,255,0.5);
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-top">
            <div style="font-size: 3.5rem; margin-bottom: 10px;">🔐</div>
            <h1>Reset Password</h1>
            <p>Enter your new password below</p>
        </div>

        <div class="card-body-form">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-danger">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <input type="hidden" name="email" value="@ViewBag.Email" />

                <label class="form-label">New Password</label>
                <input type="password" name="newPassword"
                       class="form-control"
                       placeholder="Min 8 characters" required />
                <div class="hint">
                    Must contain uppercase, number & special character
                </div>

                <label class="form-label">Confirm New Password</label>
                <input type="password" name="confirmPassword"
                       class="form-control"
                       placeholder="Repeat new password" required />

                <button type="submit" class="btn-submit">
                    Reset Password
                </button>
            </form>
        </div>
    </div>

    <div class="footer-info">
        © 2026 HospitalMS — Dublin, Ireland
    </div>
</body>
</html>