@model HospitalManagementSystem.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - HospitalMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                background: #1B3A5C;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
                padding: 20px;
            }

            .card {
                background: white;
                border-radius: 4px;
                width: 100%;
                max-width: 580px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.3);
                overflow: hidden;
            }

            .card-top {
                padding: 35px 45px 25px;
                text-align: center;
                border-bottom: 1px solid #eee;
            }

                .card-top h1 {
                    font-size: 1.8rem;
                    font-weight: 700;
                    color: #1B3A5C;
                    margin-bottom: 5px;
                }

                .card-top p {
                    color: #999;
                    font-size: 0.88rem;
                }

            .card-body-form {
                padding: 30px 45px 35px;
            }

            /* Role Selection */
            .role-selector {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-bottom: 25px;
            }

            .role-option {
                border: 2px solid #e0e0e0;
                border-radius: 8px;
                padding: 15px;
                text-align: center;
                cursor: pointer;
                transition: all 0.2s;
            }

                .role-option:hover {
                    border-color: #1B3A5C;
                    background: #f8fafc;
                }

                .role-option.selected {
                    border-color: #1B3A5C;
                    background: #f0f4f8;
                }

                .role-option .icon {
                    font-size: 2rem;
                    margin-bottom: 8px;
                }

                .role-option .title {
                    font-weight: 700;
                    color: #1B3A5C;
                    font-size: 0.95rem;
                }

                .role-option .desc {
                    color: #888;
                    font-size: 0.78rem;
                    margin-top: 4px;
                }

            .form-label {
                font-weight: 600;
                color: #333;
                font-size: 0.88rem;
                margin-bottom: 6px;
                display: block;
            }

            .form-control {
                width: 100%;
                border-radius: 4px;
                padding: 13px 15px;
                border: 1px solid #ccc;
                font-size: 0.95rem;
                background: #f5f7fa;
                margin-bottom: 16px;
            }

                .form-control:focus {
                    border-color: #1B3A5C;
                    background: white;
                    outline: none;
                }

            .btn-register {
                width: 100%;
                background: #1B3A5C;
                color: white;
                border: none;
                border-radius: 4px;
                padding: 14px;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
                margin-top: 5px;
            }

                .btn-register:hover {
                    background: #2B6CB0;
                }

            .login-link {
                text-align: center;
                margin-top: 20px;
                font-size: 0.88rem;
                color: #888;
            }

                .login-link a {
                    color: #1B3A5C;
                    font-weight: 600;
                    text-decoration: none;
                }

            .footer-info {
                text-align: center;
                margin-top: 15px;
                font-size: 0.78rem;
                color: rgba(255,255,255,0.5);
            }

            .alert-danger {
                background: #fff5f5;
                border-left: 4px solid #e53e3e;
                border-radius: 4px;
                padding: 12px 15px;
                font-size: 0.85rem;
                color: #c53030;
                margin-bottom: 20px;
            }

            .text-danger {
                font-size: 0.78rem;
                color: #e53e3e;
            }

            .hint {
                font-size: 0.78rem;
                color: #aaa;
                margin-bottom: 16px;
            }

            .section-divider {
                border: none;
                border-top: 1px solid #eee;
                margin: 20px 0;
            }

            .section-title {
                font-size: 0.82rem;
                font-weight: 700;
                color: #1B3A5C;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 15px;
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-top">
            <div style="font-size: 3.5rem; margin-bottom: 10px;">🏥</div>
            <h1>HospitalMS</h1>
            <p>Create your account</p>
        </div>

        <div class="card-body-form">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-danger">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <!-- Account Type Selection -->
            <p class="section-title">I am registering as:</p>
            <div class="role-selector">
                <div class="role-option selected" id="patientOption"
                     onclick="selectRole('Patient')">
                    <div class="icon">👤</div>
                    <div class="title">Patient</div>
                    <div class="desc">Book appointments & manage my health</div>
                </div>
                <div class="role-option" id="staffOption"
                     onclick="selectRole('Staff')">
                    <div class="icon">👨‍💼</div>
                    <div class="title">Staff Member</div>
                    <div class="desc">Hospital staff & administrators</div>
                </div>
            </div>

            <form asp-action="Register" method="post">
                <input type="hidden" name="AccountType"
                       id="accountType" value="Patient" />

                <hr class="section-divider" />
                <p class="section-title">Personal Information</p>

                <label class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control"
                       placeholder="John Smith" />
                <span asp-validation-for="FullName" class="text-danger"></span>

                <label class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control"
                       placeholder="your@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <!-- Patient Extra Fields -->
                <div id="patientFields">
                    <label class="form-label">Date of Birth</label>
                    <input type="date" name="DateOfBirth"
                           class="form-control" />

                    <label class="form-label">Phone Number</label>
                    <input type="tel" name="PhoneNumber"
                           class="form-control"
                           placeholder="+353 ..." />

                    <label class="form-label">Gender</label>
                    <select name="Gender" class="form-control">
                        <option value="">-- Select Gender --</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <hr class="section-divider" />
                <p class="section-title">Security</p>

                <label class="form-label">Password</label>
                <input asp-for="Password" class="form-control"
                       placeholder="Min 8 characters" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="hint">
                    Must contain uppercase, number & special character
                </div>

                <label class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control"
                       placeholder="Repeat password" />
                <span asp-validation-for="ConfirmPassword"
                      class="text-danger"></span>

                <button type="submit" class="btn-register">
                    Create Account
                </button>
            </form>

            <div class="login-link">
                Already have an account?
                <a asp-action="Login">Sign in here</a>
            </div>
        </div>
    </div>

    <div class="footer-info">
        © 2026 HospitalMS — Dublin, Ireland
    </div>

    <script>
            function selectRole(role) {
                document.getElementById('accountType').value = role;

                if (role === 'Patient') {
                    document.getElementById('patientOption')
                        .classList.add('selected');
                    document.getElementById('staffOption')
                        .classList.remove('selected');
                    document.getElementById('patientFields')
                        .style.display = 'block';
                } else {
                    document.getElementById('staffOption')
                        .classList.add('selected');
                    document.getElementById('patientOption')
                        .classList.remove('selected');
                    document.getElementById('patientFields')
                        .style.display = 'none';
                }
            }
    </script>
</body>
</html>