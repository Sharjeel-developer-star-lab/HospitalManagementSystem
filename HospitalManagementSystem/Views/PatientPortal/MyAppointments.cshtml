@model IEnumerable<HospitalManagementSystem.Models.Appointment>
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">📅 My Appointments</h2>
        <a asp-action="BookAppointment" class="btn btn-primary">
            + Book New Appointment
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div style="font-size: 4rem;">📅</div>
                <h5 class="mt-3">No Appointments Yet</h5>
                <p class="text-muted">
                    Book your first appointment with one of our doctors
                </p>
                <a asp-action="BookAppointment" class="btn btn-primary">
                    Book Appointment
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>Department</th>
                            <th>Date & Time</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var apt in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        Dr. @apt.Doctor?.FirstName
                                        @apt.Doctor?.LastName
                                    </strong>
                                </td>
                                <td>@apt.Doctor?.Specialization</td>
                                <td>@apt.Doctor?.Department?.Name</td>
                                <td>
                                    @apt.AppointmentDate.ToString("dd/MM/yyyy")
                                    <br />
                                    <small class="text-muted">
                                        @apt.AppointmentDate.ToString("HH:mm")
                                    </small>
                                </td>
                                <td>
                                    @if (apt.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">
                                            ✅ Confirmed
                                        </span>
                                    }
                                    else if (apt.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">
                                            ⏳ Pending
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            ❌ Cancelled
                                        </span>
                                    }
                                </td>
                                <td>
                                    <small>@apt.Notes</small>
                                </td>
                                <td>
                                    @if (apt.Status == "Pending" &&
                                        apt.AppointmentDate > DateTime.Now)
                                    {
                                        <a asp-action="CancelAppointment"
                                           asp-route-id="@apt.Id"
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Cancel this appointment?')">
                                            Cancel
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>