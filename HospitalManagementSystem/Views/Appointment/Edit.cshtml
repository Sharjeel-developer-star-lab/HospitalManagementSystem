@model HospitalManagementSystem.Models.Appointment
@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-0">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">✏️ Edit Appointment</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="PatientId" class="form-label fw-bold">Patient</label>
                            <select asp-for="PatientId" asp-items="ViewBag.Patients"
                                    class="form-select">
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DoctorId" class="form-label fw-bold">Doctor</label>
                            <select asp-for="DoctorId" asp-items="ViewBag.Doctors"
                                    class="form-select">
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AppointmentDate" class="form-label fw-bold"></label>
                            <input asp-for="AppointmentDate" class="form-control"
                                   type="datetime-local" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pending">Pending</option>
                                <option value="Confirmed">Confirmed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">💾 Update</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>