@{
    ViewData["Title"] = "Dashboard";
}

<!-- Hero Section -->
<div class="bg-primary text-white rounded-3 p-4 mb-4"
     style="background: linear-gradient(135deg, #1B3A5C, #2B6CB0) !important;">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold">🏥 HospitalMS Dashboard</h1>
            <p class="lead mb-0">Welcome to Hospital Management System</p>
            <p class="mb-0 opacity-75">
                @DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-controller="Appointment" asp-action="Create"
               class="btn btn-light btn-lg">
                📅 Book Appointment
            </a>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100"
             style="border-left: 5px solid #1B3A5C !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Total Patients</p>
                        <h2 class="fw-bold text-primary mb-0">
                            @ViewBag.TotalPatients
                        </h2>
                    </div>
                    <div style="font-size: 3rem;">👤</div>
                </div>
                <a asp-controller="Patient" asp-action="Index"
                   class="btn btn-sm btn-outline-primary mt-2">
                    View All
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100"
             style="border-left: 5px solid #28a745 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Total Doctors</p>
                        <h2 class="fw-bold text-success mb-0">
                            @ViewBag.TotalDoctors
                        </h2>
                    </div>
                    <div style="font-size: 3rem;">👨‍⚕️</div>
                </div>
                <a asp-controller="Doctor" asp-action="Index"
                   class="btn btn-sm btn-outline-success mt-2">
                    View All
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100"
             style="border-left: 5px solid #ffc107 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Total Appointments</p>
                        <h2 class="fw-bold text-warning mb-0">
                            @ViewBag.TotalAppointments
                        </h2>
                    </div>
                    <div style="font-size: 3rem;">📅</div>
                </div>
                <a asp-controller="Appointment" asp-action="Index"
                   class="btn btn-sm btn-outline-warning mt-2">
                    View All
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100"
             style="border-left: 5px solid #17a2b8 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Departments</p>
                        <h2 class="fw-bold text-info mb-0">
                            @ViewBag.TotalDepartments
                        </h2>
                    </div>
                    <div style="font-size: 3rem;">🏥</div>
                </div>
                <a asp-controller="Department" asp-action="Index"
                   class="btn btn-sm btn-outline-info mt-2">
                    View All
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Appointment Status Row -->
<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">⏳ Pending Appointments</p>
                    <h3 class="fw-bold text-warning mb-0">
                        @ViewBag.PendingAppointments
                    </h3>
                </div>
                <span class="badge bg-warning fs-5 p-3">Pending</span>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">✅ Confirmed Appointments</p>
                    <h3 class="fw-bold text-success mb-0">
                        @ViewBag.ConfirmedAppointments
                    </h3>
                </div>
                <span class="badge bg-success fs-5 p-3">Confirmed</span>
            </div>
        </div>
    </div>
</div>

<!-- Recent Data Row -->
<div class="row">
    <!-- Recent Appointments -->
    <div class="col-md-7 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between">
                <h5 class="mb-0 text-primary">📅 Recent Appointments</h5>
                <a asp-controller="Appointment" asp-action="Create"
                   class="btn btn-sm btn-primary">+ Book</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentAppointments != null &&
                     ((List<HospitalManagementSystem.Models.Appointment>)
                     ViewBag.RecentAppointments).Count > 0)
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var apt in
                                (List<HospitalManagementSystem.Models.Appointment>)
                                ViewBag.RecentAppointments)
                            {
                                <tr>
                                    <td>@apt.Patient?.FirstName @apt.Patient?.LastName</td>
                                    <td>Dr. @apt.Doctor?.LastName</td>
                                    <td>@apt.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (apt.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">✅ Confirmed</span>
                                        }
                                        else if (apt.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">⏳ Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">❌ Cancelled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3">No appointments yet.</p>
                }
            </div>
        </div>
    </div>

    <!-- Recent Patients -->
    <div class="col-md-5 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between">
                <h5 class="mb-0 text-primary">👤 Recent Patients</h5>
                <a asp-controller="Patient" asp-action="Create"
                   class="btn btn-sm btn-success">+ Add</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentPatients != null &&
                     ((List<HospitalManagementSystem.Models.Patient>)
                     ViewBag.RecentPatients).Count > 0)
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var patient in
                            (List<HospitalManagementSystem.Models.Patient>)
                            ViewBag.RecentPatients)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <div>
                                    <strong>@patient.FirstName @patient.LastName</strong>
                                    <br />
                                    <small class="text-muted">@patient.Email</small>
                                </div>
                                <span class="badge bg-primary rounded-pill">
                                    @patient.BloodType
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted p-3">No patients yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 text-primary">⚡ Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-flex gap-3 flex-wrap">
                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <a asp-controller="Patient" asp-action="Create"
                           class="btn btn-primary">
                            👤 Register Patient
                        </a>
                        <a asp-controller="Doctor" asp-action="Create"
                           class="btn btn-success">
                            👨‍⚕️ Add Doctor
                        </a>
                        <a asp-controller="Appointment" asp-action="Create"
                           class="btn btn-warning">
                            📅 Book Appointment
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Department" asp-action="Create"
                           class="btn btn-info">
                            🏥 Add Department
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>